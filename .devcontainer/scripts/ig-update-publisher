#!/usr/bin/env bash
# Task "Update IG Publisher". Fetches the current HL7 release into input-cache.
set -uo pipefail

. /usr/local/share/ig-devcontainer/lib.sh

if [ ! -f _updatePublisher.sh ]; then
  echo "✗ _updatePublisher.sh not found - is this an IG workspace?"
  exit 1
fi

# Left by earlier versions of this image; the publisher refuses it now.
if [ -L "$CACHE_JAR" ]; then
  rm -f "$CACHE_JAR"
fi

# With no jar in input-cache/, _updatePublisher.sh downloads to ../publisher.jar
# when that exists - with `curl -o`, which would follow our link into the
# root-owned image jar and fail. Take the link away so it picks input-cache/,
# and put it back afterwards: the fresh copy in input-cache/ takes precedence
# anyway, and the link is the fallback once post-create removes that copy.
relink=false
if [ -L "$PARENT_JAR" ]; then
  as_needed rm -f "$PARENT_JAR" && relink=true
fi

bash _updatePublisher.sh -y
rc=$?

if $relink; then
  link_parent_jar || echo "⚠ Could not restore the link $PARENT_JAR"
fi
exit $rc
