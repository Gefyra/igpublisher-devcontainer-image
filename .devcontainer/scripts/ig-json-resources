#!/usr/bin/env bash
# Task "Download: JSON Resources". Zips the SUSHI output for download.
set -uo pipefail

src=fsh-generated/resources
out=json-resources.zip

if [ ! -d "$src" ]; then
  echo "✗ $src does not exist. Run the SUSHI build first."
  exit 1
fi

if [ -z "$(find "$src" -name '*.json' -print -quit)" ]; then
  echo "✗ No JSON files found in $src."
  exit 1
fi

echo "Creating ZIP archive..."
rm -f "$out"
zip -r "$out" "$src"/*.json || exit 1

echo ""
echo "✓ $out created"
echo ""
echo "Path: $out"
echo "In VS Code: right-click the file → Download..."
echo ""
ls -lh "$out"
