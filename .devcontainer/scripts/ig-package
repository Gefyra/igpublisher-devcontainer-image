#!/usr/bin/env bash
# Task "Download: IG Package". Points at the built package for download.
set -uo pipefail

if [ ! -f output/full-ig.zip ]; then
  echo "✗ output/full-ig.zip does not exist. Run a full build first."
  exit 1
fi

echo "✓ full-ig.zip is ready"
echo ""
echo "Path: output/full-ig.zip"
echo "In VS Code: right-click the file → Download..."
echo ""
ls -lh output/full-ig.zip
