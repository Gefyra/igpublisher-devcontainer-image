#!/usr/bin/env bash
# Task "Download: IG Package". Points at the built package for download.
set -uo pipefail

if [ ! -f output/full-ig.zip ]; then
  echo "✗ Fehler: output/full-ig.zip existiert nicht. Bitte erst einen Full Build durchführen."
  exit 1
fi

echo "✓ full-ig.zip bereit zum Download"
echo ""
echo "Pfad: output/full-ig.zip"
echo "Im VS Code: Rechtsklick auf Datei → Download..."
echo ""
ls -lh output/full-ig.zip
